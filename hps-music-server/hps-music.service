# Linux (Ubuntu/Debian) always-on service.
# 1. Copy the hps-music-server folder to /opt/hps-music-server
# 2. sudo cp hps-music.service /etc/systemd/system/
# 3. sudo systemctl enable --now hps-music
[Unit]
Description=HPS Music Room server
After=network.target

[Service]
WorkingDirectory=/opt/hps-music-server
ExecStart=/usr/bin/node server.js
Environment=PORT=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
